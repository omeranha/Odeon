# Copy to server/.env for `npm run dev:server`.
NAVIDROME_URL=http://localhost:4533

# Optional: enables "Get music" (downloads through Downtify). Leave empty to hide the feature.
# The token is a Downtify device token (POST /api/auth/token) for a non-admin Downtify account.
DOWNTIFY_URL=http://localhost:8000
DOWNTIFY_TOKEN=
# Optional: a Downtify admin account. Used for explicit-version replacement, song deletion and storage
# statistics. Downtify only allows these from an admin session, so the server signs in with this account.
# DOWNTIFY_ADMIN_USERNAME=
# DOWNTIFY_ADMIN_PASSWORD=

# Optional: Settings, Better quality (see docs/soulseek.md). slskd's address and API key, Downtify's downloads folder as this
# server sees it (read and write) and slskd's download folder.
# SLSKD_URL=http://localhost:5030
# SLSKD_API_KEY=
# LIBRARY_DIR=
# SLSKD_DIR=

# Optional: the Alexa skill (see README). Its ID from the Alexa Developer Console, and the Navidrome user the Echo
# plays as. Stream links use the first WEBAUTHN_ORIGINS unless ALEXA_PUBLIC_URL is set; it must be public HTTPS.
# ALEXA_SKILL_ID=amzn1.ask.skill.
# ALEXA_USERNAME=
# ALEXA_PUBLIC_URL=

# Only needed when this server should also serve the built PWA (production).
# STATIC_DIR=../dist
# PORT=3000

# Sign-in uses invite links and passkeys. Navidrome must trust this server's address for the Remote-User header
# (ND_EXTAUTH_TRUSTEDSOURCES) and nobody else's. Passkeys are bound to WEBAUTHN_RP_ID; invite links use the first origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173

# Addresses allowed to set CF-Connecting-IP / X-Forwarded-For (the cloudflared container's network).
# TRUSTED_PROXIES=172.18.0.0/16
# Optional: set to false to stop streaming YouTube Music songs directly (first play then waits for Downtify).
# DIRECT_STREAM=true
# Optional: how often (minutes) the server upgrades library songs from Soulseek by itself; 0 means only from Settings.
# QUALITY_AUTO_MINUTES=60
# Optional: the Navidrome administrator used to ask Navidrome to rescan after an automatic upgrade.
# QUALITY_AUTO_USER=admin
